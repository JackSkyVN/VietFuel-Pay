# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Smart Refuel System API"
APP_VERSION="1.0.0"
DEBUG=true
API_V1_PREFIX="/api/v1"

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/smart_refuel"

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="CHANGE_ME_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# ── External Payment Gateway ──────────────────────────────────────────────────
PAYMENT_GATEWAY_URL="https://sandbox.payment-gateway.vn/api/charge"
PAYMENT_GATEWAY_API_KEY="sandbox-key"

# ── Geofencing ────────────────────────────────────────────────────────────────
GEOFENCE_RADIUS_METERS=300.0
# Station GPS coordinates (default: HCMC demo)
STATION_LAT=10.7769
STATION_LON=106.7009

# ── Offline QR ────────────────────────────────────────────────────────────────
QR_EXPIRY_SECONDS=300

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["*"]
